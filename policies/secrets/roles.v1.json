{
  "schema_version": "1.0",
  "kind": "offline_policy_not_credential_issuance",
  "max_lifetime_seconds": 300,
  "default": "DENY",
  "roles": {
    "bootstrap_admin": [
      "github.repository.admin",
      "github.project.admin"
    ],
    "metadata_coordinator": [
      "github.issue.read",
      "github.issue.write",
      "github.project.read",
      "github.project.write"
    ],
    "coding_worker": [
      "source.read",
      "artifact.write"
    ],
    "reviewer": [
      "source.read",
      "artifact.read",
      "review.report"
    ],
    "integrator": [
      "source.read",
      "artifact.read",
      "github.branch.write",
      "github.pr.write",
      "github.merge.request"
    ],
    "production_operator": [
      "runtime.secret.reference",
      "runtime.deploy.request"
    ]
  },
  "worker_forbidden": [
    "github.repository.admin",
    "github.project.admin",
    "age.private_key",
    "smtp.credential",
    "sip.credential",
    "payment.credential",
    "deploy.token",
    "model.api_key"
  ],
  "native_execution_auth": "existing ChatGPT subscription; no API-key authentication",
  "baseline": [
    "SOPS+age",
    "Podman/systemd file-secret references"
  ],
  "external_effects": "HOLD"
}
