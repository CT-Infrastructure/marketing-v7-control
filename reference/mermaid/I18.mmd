flowchart TB
  IN["I18: Storage provisioning or content ingestion"]:::source
  CONTROL["Required controls<br/>X11"]:::control
  S1["Define durable asset and intermediate<br/>retention classes<br/><b>ResourceSpace / OpenProject</b>"]:::process
  IN --> S1
  S2["Configure required master, volume, filer and<br/>gateway roles<br/><b>SeaweedFS</b>"]:::process
  S1 --> S2
  S3["Bind each application through supported<br/>storage interfaces<br/><b>Native application configuration</b>"]:::process
  S2 --> S3
  S4["Record checksums, rights and metadata<br/>references<br/><b>PostgreSQL / ResourceSpace</b>"]:::process
  S3 --> S4
  GATE{"Object and metadata restore<br/>consistent?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S5["Back up objects and coordinating metadata<br/>off-host<br/><b>restic / database tools</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Asset storage with provenance and tested<br/>recovery"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>C33, C43, C49, C57, V10, I23"]:::ext
  OUT --> NEXT

