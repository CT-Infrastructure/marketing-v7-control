flowchart TB
  IN["X02: Accepted event or retry-safe job"]:::source
  S1["Insert source event with unique<br/>client/source/event key<br/><b>PostgreSQL</b>"]:::process
  IN --> S1
  S2["Atomically record domain transition and<br/>action intent<br/><b>PostgreSQL transaction</b>"]:::process
  S1 --> S2
  S3["Claim bounded work with lease and fencing<br/>metadata<br/><b>Activepieces / Python worker</b>"]:::process
  S2 --> S3
  S4["Recheck permission and execution ownership<br/><b>Channel guard</b>"]:::process
  S3 --> S4
  GATE{"Action eligible and no unresolved<br/>prior attempt?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  S5["Store attempt and external identifier before<br/>completion<br/><b>PostgreSQL</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Durable action ledger and replay-safe local<br/>state"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>X03, X04, X05, X06, X07"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
classDef process fill:#f8fafc,stroke:#94a3b8,color:#172554,stroke-width:1.4px;
classDef gate fill:#fff7d6,stroke:#d97706,color:#78350f,stroke-width:1.8px;
classDef control fill:#ede9fe,stroke:#8b5cf6,color:#4c1d95,stroke-dasharray:5 4;
classDef done fill:#ccfbf1,stroke:#0f766e,color:#134e4a,stroke-width:1.8px;
classDef hold fill:#fff1f2,stroke:#e11d48,color:#881337,stroke-width:1.5px;
classDef legacy fill:#fdf2f8,stroke:#9d174d,color:#831843;
classDef ext fill:#ecfeff,stroke:#0891b2,color:#164e63;

