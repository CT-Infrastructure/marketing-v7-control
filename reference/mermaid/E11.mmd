flowchart TB
  IN["E11: Mautic native queued, immediate or manual<br/>send"]:::source
  CONTROL["Required controls<br/>X02, X03, X04, X06, X09"]:::control
  S1["Claim native send intent without bypassing<br/>Mautic ownership<br/><b>Mautic supported transport hook</b>"]:::process
  IN --> S1
  S2["Re-read eligibility, sender HOLD and<br/>approved revision<br/><b>Custom dispatch guard</b>"]:::process
  S1 --> S2
  S3["Atomically reserve per-sender and provider<br/>capacity<br/><b>E12 / PostgreSQL</b>"]:::process
  S2 --> S3
  GATE{"Recipient, revision and quota valid<br/>at last boundary?"}:::gate
  S3 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S4["Submit through the only authorized<br/>production transport<br/><b>Managed SMTP</b>"]:::process
  GATE -- "Yes" --> S4
  S5["Store accepted, rejected or UNKNOWN receipt<br/><b>PostgreSQL</b>"]:::process
  S4 --> S5
  S6["Reconcile before retry or reservation<br/>release<br/><b>X06</b>"]:::process
  S5 --> S6
  OUT["Guarded send attempt and durable receipt"]:::done
  S6 --> OUT
  NEXT["Connected handoffs<br/>E06, X06"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
classDef process fill:#f8fafc,stroke:#94a3b8,color:#172554,stroke-width:1.4px;
classDef gate fill:#fff7d6,stroke:#d97706,color:#78350f,stroke-width:1.8px;
classDef control fill:#ede9fe,stroke:#8b5cf6,color:#4c1d95,stroke-dasharray:5 4;
classDef done fill:#ccfbf1,stroke:#0f766e,color:#134e4a,stroke-width:1.8px;
classDef hold fill:#fff1f2,stroke:#e11d48,color:#881337,stroke-width:1.5px;
classDef legacy fill:#fdf2f8,stroke:#9d174d,color:#831843;
classDef ext fill:#ecfeff,stroke:#0891b2,color:#164e63;

