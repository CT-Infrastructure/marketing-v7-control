flowchart TB
  IN["I32: Retirement decision or storage cleanup<br/>request"]:::source
  CONTROL["Required controls<br/>X11"]:::control
  S1["Preserve intended 410 and hold responses<br/><b>Caddy / route register</b>"]:::process
  IN --> S1
  S2["Identify orphan volumes, images and their<br/>owners<br/><b>Legacy recovery inventory</b>"]:::process
  S1 --> S2
  S3["Apply explicit retention and legal-hold<br/>review<br/><b>OpenProject</b>"]:::process
  S2 --> S3
  S4["Export approved archives and revoke<br/>credentials<br/><b>restic / native providers</b>"]:::process
  S3 --> S4
  GATE{"Retention and irreversible action<br/>approved?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S5["Delete only specifically approved scope<br/>after evidence<br/><b>Authorized operator</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Audited retirement with preserved endpoint<br/>intent"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>L08, X08"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
classDef process fill:#f8fafc,stroke:#94a3b8,color:#172554,stroke-width:1.4px;
classDef gate fill:#fff7d6,stroke:#d97706,color:#78350f,stroke-width:1.8px;
classDef control fill:#ede9fe,stroke:#8b5cf6,color:#4c1d95,stroke-dasharray:5 4;
classDef done fill:#ccfbf1,stroke:#0f766e,color:#134e4a,stroke-width:1.8px;
classDef hold fill:#fff1f2,stroke:#e11d48,color:#881337,stroke-width:1.5px;
classDef legacy fill:#fdf2f8,stroke:#9d174d,color:#831843;
classDef ext fill:#ecfeff,stroke:#0891b2,color:#164e63;

