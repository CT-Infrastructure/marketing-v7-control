flowchart TB
  IN["I26: Failed canary or regression"]:::source
  CONTROL["Required controls<br/>X11"]:::control
  S1["Freeze destination external actions and<br/>preserve new evidence<br/><b>Channel guards / systemd</b>"]:::process
  IN --> S1
  S2["Compare source and destination writes plus<br/>provider receipts<br/><b>PostgreSQL / native APIs</b>"]:::process
  S1 --> S2
  S3["Choose data-forward recovery or approved<br/>rollback point<br/><b>Human owner</b>"]:::process
  S2 --> S3
  GATE{"No lost writes or duplicate external<br/>actions?"}:::gate
  S3 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S4["Restore compatible data and software<br/>generation<br/><b>Backup tools / Ansible</b>"]:::process
  GATE -- "Yes" --> S4
  S5["Reconcile DNS, identities and one active<br/>scheduler<br/><b>OpenWrt / provider</b>"]:::process
  S4 --> S5
  S6["Retest held state before resuming<br/><b>Playwright / OpenProject</b>"]:::process
  S5 --> S6
  OUT["Auditable rollback or forward-repair<br/>decision"]:::done
  S6 --> OUT
  NEXT["Connected handoffs<br/>I24, X06"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
classDef process fill:#f8fafc,stroke:#94a3b8,color:#172554,stroke-width:1.4px;
classDef gate fill:#fff7d6,stroke:#d97706,color:#78350f,stroke-width:1.8px;
classDef control fill:#ede9fe,stroke:#8b5cf6,color:#4c1d95,stroke-dasharray:5 4;
classDef done fill:#ccfbf1,stroke:#0f766e,color:#134e4a,stroke-width:1.8px;
classDef hold fill:#fff1f2,stroke:#e11d48,color:#881337,stroke-width:1.5px;
classDef legacy fill:#fdf2f8,stroke:#9d174d,color:#831843;
classDef ext fill:#ecfeff,stroke:#0891b2,color:#164e63;

