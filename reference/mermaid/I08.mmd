flowchart TB
  IN["I08: Remote administration or VPN migration"]:::source
  CONTROL["Required controls<br/>X11"]:::control
  S1["Inventory hosted Tailscale and local<br/>Headscale separately<br/><b>Tailscale / Headscale</b>"]:::process
  IN --> S1
  S2["Choose the intended control plane per device<br/><b>Authorized account owner</b>"]:::process
  S1 --> S2
  S3["Preserve enrollment and ACL policy<br/>references<br/><b>SOPS / age</b>"]:::process
  S2 --> S3
  S4["Validate routes, DNS, expiry and revocation<br/><b>Tailscale / Headscale</b>"]:::process
  S3 --> S4
  GATE{"Access and revocation tested?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S5["Prove independent LAN console fallback<br/><b>OpenSSH / local console</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Approved private-management paths without<br/>assumed federation"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>I13, I29, I35"]:::ext
  OUT --> NEXT

