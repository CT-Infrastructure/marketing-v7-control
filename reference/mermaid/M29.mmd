flowchart TB
  IN["M29: Completed eligible customer service/order<br/>event"]:::source
  CONTROL["Required controls<br/>X01, X02, X03, X06, X10, X04, E11"]:::control
  S1["Eligible customer event<br/><b>Native owner / bounded integration</b>"]:::process
  IN --> S1
  GATE{"Applicable permission, approval and<br/>destination readiness valid?"}:::gate
  S1 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S2["Mautic neutral request<br/><b>Mautic</b>"]:::process
  GATE -- "Yes" --> S2
  S3["WordPress/public review link<br/><b>WordPress</b>"]:::process
  S2 --> S3
  S4["Moderate authentic feedback<br/><b>Native owner / bounded integration</b>"]:::process
  S3 --> S4
  S5["Report aggregate results<br/><b>Native owner / bounded integration</b>"]:::process
  S4 --> S5
  OUT["Authentic review request and moderation<br/>outcome"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>M30, M05"]:::ext
  OUT --> NEXT

