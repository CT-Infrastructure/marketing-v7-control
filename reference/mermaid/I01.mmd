flowchart TB
  IN["I01: Start of consolidation, rebuild or periodic<br/>audit"]:::source
  CONTROL["Required controls<br/>X11"]:::control
  S1["Hash source bundle and record audit<br/>timestamps<br/><b>Git / Python</b>"]:::process
  IN --> S1
  S2["Inventory rootful, rootless, VM and router<br/>scopes<br/><b>Ansible / authorized owners</b>"]:::process
  S1 --> S2
  S3["Compare declared units, mounts and actual<br/>listeners<br/><b>systemd / Podman / Proxmox</b>"]:::process
  S2 --> S3
  S4["Record denied or unavailable scopes<br/>explicitly<br/><b>OpenProject</b>"]:::process
  S3 --> S4
  GATE{"Scope complete or explicitly blocked?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S5["Link every service, route and recovery<br/>record<br/><b>PostgreSQL / versioned register</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Dated inventory, source manifest and<br/>unresolved access register"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>I02, I03, I04"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
classDef process fill:#f8fafc,stroke:#94a3b8,color:#172554,stroke-width:1.4px;
classDef gate fill:#fff7d6,stroke:#d97706,color:#78350f,stroke-width:1.8px;
classDef control fill:#ede9fe,stroke:#8b5cf6,color:#4c1d95,stroke-dasharray:5 4;
classDef done fill:#ccfbf1,stroke:#0f766e,color:#134e4a,stroke-width:1.8px;
classDef hold fill:#fff1f2,stroke:#e11d48,color:#881337,stroke-width:1.5px;
classDef legacy fill:#fdf2f8,stroke:#9d174d,color:#831843;
classDef ext fill:#ecfeff,stroke:#0891b2,color:#164e63;

