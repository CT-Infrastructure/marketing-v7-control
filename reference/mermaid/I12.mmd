flowchart TB
  IN["I12: Provisioning, expiry or incident"]:::source
  CONTROL["Required controls<br/>X11"]:::control
  S1["Assign scoped references and custodians<br/><b>SOPS / age</b>"]:::process
  IN --> S1
  S2["Deliver runtime secrets with minimal read<br/>scope<br/><b>Ansible / systemd</b>"]:::process
  S1 --> S2
  S3["Preserve application encryption keys with<br/>database backup<br/><b>Vaultwarden / offline custody</b>"]:::process
  S2 --> S3
  S4["Rotate provider and machine credentials<br/>through staged tests<br/><b>Native APIs</b>"]:::process
  S3 --> S4
  GATE{"New identity proven and old access<br/>revoked?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S5["Revoke replaced identities and log metadata<br/>only<br/><b>OpenProject</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Recoverable, scoped credential generation"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>I13, I14, E01, V01, X11"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
classDef process fill:#f8fafc,stroke:#94a3b8,color:#172554,stroke-width:1.4px;
classDef gate fill:#fff7d6,stroke:#d97706,color:#78350f,stroke-width:1.8px;
classDef control fill:#ede9fe,stroke:#8b5cf6,color:#4c1d95,stroke-dasharray:5 4;
classDef done fill:#ccfbf1,stroke:#0f766e,color:#134e4a,stroke-width:1.8px;
classDef hold fill:#fff1f2,stroke:#e11d48,color:#881337,stroke-width:1.5px;
classDef legacy fill:#fdf2f8,stroke:#9d174d,color:#831843;
classDef ext fill:#ecfeff,stroke:#0891b2,color:#164e63;

