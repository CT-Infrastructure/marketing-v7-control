flowchart TB
  IN["M27: Partner application, referral click, or<br/>verified order"]:::source
  CONTROL["Required controls<br/>X01, X02, X03, X06, X10"]:::control
  S1["Partner application<br/><b>Native owner / bounded integration</b>"]:::process
  IN --> S1
  S2["Approve account and terms<br/><b>Native owner / bounded integration</b>"]:::process
  S1 --> S2
  S3["Conversion / refund verify<br/><b>Native owner / bounded integration</b>"]:::process
  S2 --> S3
  S4["PostgreSQL commission ledger<br/><b>PostgreSQL</b>"]:::process
  S3 --> S4
  GATE{"Applicable permission, approval and<br/>destination readiness valid?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S5["Human payout authorization<br/><b>Native owner / bounded integration</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Validated partner earnings with approved<br/>payout evidence"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>M05"]:::ext
  OUT --> NEXT

