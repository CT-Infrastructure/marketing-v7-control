flowchart TB
  IN["I35: SSO, VPN or main-server failure"]:::source
  CONTROL["Required controls<br/>X11"]:::control
  S1["Retrieve approved offline credentials and<br/>contact tree<br/><b>KeePassXC / offline custody</b>"]:::process
  IN --> S1
  S2["Use local console or independent authorized<br/>LAN access<br/><b>OpenSSH / console</b>"]:::process
  S1 --> S2
  GATE{"Normal access restored and emergency<br/>keys reconciled?"}:::gate
  S2 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S3["Restore time, DNS and identity dependencies<br/>in order<br/><b>OpenWrt / chrony / Keycloak</b>"]:::process
  GATE -- "Yes" --> S3
  S4["Audit emergency actions and rotate used<br/>secrets<br/><b>OpenProject / SOPS</b>"]:::process
  S3 --> S4
  S5["Test normal access before closing emergency<br/>session<br/><b>Operator</b>"]:::process
  S4 --> S5
  OUT["Recovery access with a complete audit trail"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>I12, I24"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
classDef process fill:#f8fafc,stroke:#94a3b8,color:#172554,stroke-width:1.4px;
classDef gate fill:#fff7d6,stroke:#d97706,color:#78350f,stroke-width:1.8px;
classDef control fill:#ede9fe,stroke:#8b5cf6,color:#4c1d95,stroke-dasharray:5 4;
classDef done fill:#ccfbf1,stroke:#0f766e,color:#134e4a,stroke-width:1.8px;
classDef hold fill:#fff1f2,stroke:#e11d48,color:#881337,stroke-width:1.5px;
classDef legacy fill:#fdf2f8,stroke:#9d174d,color:#831843;
classDef ext fill:#ecfeff,stroke:#0891b2,color:#164e63;

