flowchart TB
  IN["X04: Send, call, SMS, tracking or audience export"]:::source
  S1["Identify channel, purpose, jurisdiction and<br/>client<br/><b>Workflow policy</b>"]:::process
  IN --> S1
  S2["Read authoritative consent and suppression<br/><b>Mautic / call ledger / site consent</b>"]:::process
  S1 --> S2
  S3["Check campaign, time window, identity and<br/>provider constraints<br/><b>Deterministic guard</b>"]:::process
  S2 --> S3
  S4["Recheck after any queue delay<br/><b>Final destination boundary</b>"]:::process
  S3 --> S4
  GATE{"Action remains eligible at execution<br/>time?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  S5["Propagate withdrawals and invalidate queued<br/>authorization<br/><b>Activepieces / native owners</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Allowed decision or recorded suppression"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>E11, V02, M25, M32, X08"]:::ext
  OUT --> NEXT

