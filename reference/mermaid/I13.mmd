flowchart TB
  IN["I13: Application enrollment or client onboarding"]:::source
  CONTROL["Required controls<br/>X11"]:::control
  S1["Map roles, client boundaries and local<br/>emergency accounts<br/><b>OpenProject</b>"]:::process
  IN --> S1
  S2["Enable native OIDC where supported<br/><b>Keycloak / application</b>"]:::process
  S1 --> S2
  S3["Use application-local authentication when<br/>required<br/><b>Native application</b>"]:::process
  S2 --> S3
  S4["Apply site, project, asset and token scopes<br/><b>Application owners</b>"]:::process
  S3 --> S4
  GATE{"Tenant and role boundaries proven?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S5["Test cross-client denial and break-glass<br/>audit<br/><b>Playwright / operator</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Tested authentication/authorization profile<br/>per app"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>M16, M18, M19, I35"]:::ext
  OUT --> NEXT

