flowchart TB
  IN["M22: Scheduled competitor review or detected<br/>public-page change"]:::source
  CONTROL["Required controls<br/>X01, X02, X03, X06, X10"]:::control
  S1["SearXNG public discovery<br/><b>Native owner / bounded integration</b>"]:::process
  IN --> S1
  S2["Permitted Playwright snapshot<br/><b>Playwright</b>"]:::process
  S1 --> S2
  S3["PostgreSQL change check<br/><b>PostgreSQL</b>"]:::process
  S2 --> S3
  S4["llama.cpp digest<br/><b>llama.cpp</b>"]:::process
  S3 --> S4
  GATE{"Applicable permission, approval and<br/>destination readiness valid?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S5["OpenProject action<br/><b>OpenProject</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Auditable change digest and a human-approved<br/>action"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>C03, M11"]:::ext
  OUT --> NEXT

