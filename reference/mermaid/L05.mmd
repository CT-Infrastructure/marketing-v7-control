flowchart TB
  IN["L05: Approved evaluation of retained business<br/>stack"]:::source
  CONTROL["Required controls<br/>I02, I23, I30"]:::control
  S1["Separate live pod operations from explicitly<br/>held hosting<br/><b>Legacy register</b>"]:::process
  IN --> S1
  S2["Inventory WordPress/orders, SeaweedFS,<br/>Temporal and mock overrides<br/><b>Authorized owner</b>"]:::process
  S1 --> S2
  S3["Preserve external Etsy/Printify/Woo<br/>credential references<br/><b>SOPS / provider owner</b>"]:::process
  S2 --> S3
  S4["Map owned data to selected V7 services<br/>without duplicate owners<br/><b>Mautic / WordPress / PostgreSQL</b>"]:::process
  S3 --> S4
  GATE{"Owner, provider and non-mock<br/>acceptance passed?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S5["Validate signatures and real-versus-mock<br/>event paths<br/><b>X01 / tests</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Approved integration migration or continued<br/>hold"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>M07, M08, M36"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
