flowchart TB
  IN["I09: Approved VM migration"]:::source
  CONTROL["Required controls<br/>X11"]:::control
  S1["Capture guest XML, disks, chains, firmware<br/>and TPM state<br/><b>Authorized libvirt owner</b>"]:::process
  IN --> S1
  S2["Record stopped/autostart and active-run<br/>intent<br/><b>OpenProject</b>"]:::process
  S1 --> S2
  S3["Produce consistent guest and application<br/>checkpoints<br/><b>Existing backup tools</b>"]:::process
  S2 --> S3
  S4["Import reviewed disks into isolated Proxmox<br/>guests<br/><b>Proxmox VE / QEMU tools</b>"]:::process
  S3 --> S4
  S5["Reconstruct devices, NICs and boot settings<br/>explicitly<br/><b>Proxmox VE</b>"]:::process
  S4 --> S5
  GATE{"Guest state and firmware acceptance<br/>passed?"}:::gate
  S5 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S6["Validate guest services before ownership<br/>transfer<br/><b>Guest owner</b>"]:::process
  GATE -- "Yes" --> S6
  OUT["Restored VM with verified disks and<br/>preserved activation intent"]:::done
  S6 --> OUT
  NEXT["Connected handoffs<br/>I24, I30, L01, L02, L03, L04"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
classDef process fill:#f8fafc,stroke:#94a3b8,color:#172554,stroke-width:1.4px;
classDef gate fill:#fff7d6,stroke:#d97706,color:#78350f,stroke-width:1.8px;
classDef control fill:#ede9fe,stroke:#8b5cf6,color:#4c1d95,stroke-dasharray:5 4;
classDef done fill:#ccfbf1,stroke:#0f766e,color:#134e4a,stroke-width:1.8px;
classDef hold fill:#fff1f2,stroke:#e11d48,color:#881337,stroke-width:1.5px;
classDef legacy fill:#fdf2f8,stroke:#9d174d,color:#831843;
classDef ext fill:#ecfeff,stroke:#0891b2,color:#164e63;

