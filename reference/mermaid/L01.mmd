flowchart TB
  IN["L01: Separately approved legacy game/controller<br/>migration"]:::source
  CONTROL["Required controls<br/>I02, I23, I30"]:::control
  S1["Identify FLE server, controller VM and RCON<br/>owner<br/><b>Legacy manifest</b>"]:::process
  IN --> S1
  S2["Capture saves, mods, scenarios and pending<br/>controller actions<br/><b>Workload owner / restic</b>"]:::process
  S1 --> S2
  S3["Preserve production versus development<br/>network separation<br/><b>Proxmox / nftables</b>"]:::process
  S2 --> S3
  S4["Restore in isolation with controller<br/>disabled<br/><b>Existing Factorio runtime</b>"]:::process
  S3 --> S4
  GATE{"Legacy owner and original campaign<br/>window approved?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S5["Verify state and original run window before<br/>one-owner resume<br/><b>I30 / human owner</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Preserved simulation/controller state"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>L02, X10"]:::ext
  OUT --> NEXT

