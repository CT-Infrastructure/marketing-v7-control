flowchart TB
  IN["I07: New service, VLAN or cutover"]:::source
  CONTROL["Required controls<br/>X11"]:::control
  S1["Define management, application, data,<br/>sandbox and guest zones<br/><b>Ansible inventory</b>"]:::process
  IN --> S1
  S2["Review IPv4 and IPv6 effective forwarding<br/><b>firewall4 / nftables</b>"]:::process
  S1 --> S2
  S3["Permit only required application and<br/>provider paths<br/><b>OpenWrt / host firewall</b>"]:::process
  S2 --> S3
  S4["Keep databases, ARI and admin interfaces<br/>private<br/><b>nftables</b>"]:::process
  S3 --> S4
  GATE{"Positive and negative exposure tests<br/>pass?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S5["Test allowed and denied paths from each<br/>vantage<br/><b>Playwright / blackbox_exporter</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Least-privilege traffic matrix and tested<br/>rules"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>I08, I10, I14, V01"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
classDef process fill:#f8fafc,stroke:#94a3b8,color:#172554,stroke-width:1.4px;
classDef gate fill:#fff7d6,stroke:#d97706,color:#78350f,stroke-width:1.8px;
classDef control fill:#ede9fe,stroke:#8b5cf6,color:#4c1d95,stroke-dasharray:5 4;
classDef done fill:#ccfbf1,stroke:#0f766e,color:#134e4a,stroke-width:1.8px;
classDef hold fill:#fff1f2,stroke:#e11d48,color:#881337,stroke-width:1.5px;
classDef legacy fill:#fdf2f8,stroke:#9d174d,color:#831843;
classDef ext fill:#ecfeff,stroke:#0891b2,color:#164e63;

