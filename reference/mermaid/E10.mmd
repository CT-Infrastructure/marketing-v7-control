flowchart TB
  IN["E10: Scheduled operations review"]:::source
  CONTROL["Required controls<br/>X02, X03, X04, X06, X09"]:::control
  GATE{"Operational and recovery checks<br/>current?"}:::gate
  IN --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S1["Review sender identity, credentials and<br/>callback health<br/><b>checkdmarc / E14</b>"]:::process
  GATE -- "Yes" --> S1
  S2["Audit consent, segments and inactive data<br/><b>Mautic / X08</b>"]:::process
  S1 --> S2
  S3["Review quota policy, incidents and business<br/>demand<br/><b>Grafana / OpenProject</b>"]:::process
  S2 --> S3
  S4["Test backup and restore-to-HOLD<br/><b>I23 / I24</b>"]:::process
  S3 --> S4
  S5["Approve changes through versioned release<br/><b>X11</b>"]:::process
  S4 --> S5
  OUT["Maintained sender readiness and improvement<br/>backlog"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>E01, E02, E07, I23"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
