flowchart TB
  IN["I23: Backup schedule or pre-change checkpoint"]:::source
  CONTROL["Required controls<br/>X11"]:::control
  S1["Inventory consistency units and quiesce<br/>requirements<br/><b>Service recovery registry</b>"]:::process
  IN --> S1
  S2["Capture PostgreSQL, MariaDB, files and guest<br/>state<br/><b>pgBackRest / mariadb-backup / restic / Proxmox</b>"]:::process
  S1 --> S2
  S3["Preserve encryption keys and configuration<br/>generation<br/><b>SOPS / offline custody</b>"]:::process
  S2 --> S3
  GATE{"Independent copy and restore evidence<br/>present?"}:::gate
  S3 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S4["Transfer encrypted copies to independent<br/>destination<br/><b>restic / approved storage</b>"]:::process
  GATE -- "Yes" --> S4
  S5["Verify integrity, freshness and retention<br/>receipts<br/><b>Grafana / operator</b>"]:::process
  S4 --> S5
  OUT["Versioned backup generation, receipts and<br/>recovery checkpoint"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>I24, I25, I26"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
classDef process fill:#f8fafc,stroke:#94a3b8,color:#172554,stroke-width:1.4px;
classDef gate fill:#fff7d6,stroke:#d97706,color:#78350f,stroke-width:1.8px;
classDef control fill:#ede9fe,stroke:#8b5cf6,color:#4c1d95,stroke-dasharray:5 4;
classDef done fill:#ccfbf1,stroke:#0f766e,color:#134e4a,stroke-width:1.8px;
classDef hold fill:#fff1f2,stroke:#e11d48,color:#881337,stroke-width:1.5px;
classDef legacy fill:#fdf2f8,stroke:#9d174d,color:#831843;
classDef ext fill:#ecfeff,stroke:#0891b2,color:#164e63;

