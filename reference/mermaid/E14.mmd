flowchart TB
  IN["E14: Report mailbox or scheduled fetch"]:::source
  CONTROL["Required controls<br/>X02, X03, X04, X06, X09"]:::control
  GATE{"Report valid and supported output<br/>tested?"}:::gate
  IN --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S1["Read approved report mailbox securely<br/><b>parsedmarc</b>"]:::process
  GATE -- "Yes" --> S1
  S2["Parse aggregate and TLS reports with<br/>resource bounds<br/><b>parsedmarc</b>"]:::process
  S1 --> S2
  S3["Write to supported PostgreSQL output or<br/>tested adapter<br/><b>PostgreSQL</b>"]:::process
  S2 --> S3
  S4["Deduplicate and retain source timestamps<br/><b>Isolated reporting schema</b>"]:::process
  S3 --> S4
  S5["Alert on failures and privacy-sensitive<br/>report retention<br/><b>Grafana / X08</b>"]:::process
  S4 --> S5
  OUT["Traceable authentication-report history"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>E07, X10"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
