flowchart TB
  IN["X05: Approved generation, audit or conversion<br/>task"]:::source
  GATE{"Job output and budget checks passed?"}:::gate
  IN --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  S1["Resolve approved sources, job schema and<br/>tool scope<br/><b>Activepieces / PostgreSQL</b>"]:::process
  GATE -- "Yes" --> S1
  S2["Admit resource and execution budget<br/><b>systemd / I28</b>"]:::process
  S1 --> S2
  S3["Execute pinned local model or utility in<br/>isolation<br/><b>llama.cpp / FFmpeg / Playwright</b>"]:::process
  S2 --> S3
  S4["Validate structured output and reject<br/>incomplete files<br/><b>Python / Vale / ffprobe</b>"]:::process
  S3 --> S4
  S5["Store artifact hashes and provenance<br/><b>ResourceSpace / SeaweedFS</b>"]:::process
  S4 --> S5
  OUT["Validated artifact or explicit bounded<br/>failure"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>C01, C33, C49, C57, X03"]:::ext
  OUT --> NEXT

