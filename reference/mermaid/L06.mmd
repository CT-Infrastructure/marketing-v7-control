flowchart TB
  IN["L06: Unmatched bespoke app or native helper<br/>encountered"]:::source
  CONTROL["Required controls<br/>I02, I23, I30"]:::control
  S1["Identify owner, exact source and durable<br/>state<br/><b>Legacy register</b>"]:::process
  IN --> S1
  S2["Preserve custom build and API contracts<br/><b>Git / image archive</b>"]:::process
  S1 --> S2
  S3["Compare function against existing V7<br/>responsibility<br/><b>Activepieces / Grafana / OpenProject</b>"]:::process
  S2 --> S3
  S4["Isolate approved exception and disable<br/>duplicate scheduling<br/><b>systemd / Proxmox</b>"]:::process
  S3 --> S4
  GATE{"Exception has owner, scope and<br/>acceptance?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S5["Retire only on separately approved data<br/>decision<br/><b>I32</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Reviewed bespoke-service exception or<br/>preserved hold"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>X11, L08"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
classDef process fill:#f8fafc,stroke:#94a3b8,color:#172554,stroke-width:1.4px;
classDef gate fill:#fff7d6,stroke:#d97706,color:#78350f,stroke-width:1.8px;
classDef control fill:#ede9fe,stroke:#8b5cf6,color:#4c1d95,stroke-dasharray:5 4;
classDef done fill:#ccfbf1,stroke:#0f766e,color:#134e4a,stroke-width:1.8px;
classDef hold fill:#fff1f2,stroke:#e11d48,color:#881337,stroke-width:1.5px;
classDef legacy fill:#fdf2f8,stroke:#9d174d,color:#831843;
classDef ext fill:#ecfeff,stroke:#0891b2,color:#164e63;

