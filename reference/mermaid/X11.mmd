flowchart TB
  IN["X11: Change request or new integration"]:::source
  S1["Version source, contracts, prompts and<br/>policy<br/><b>Git / Forgejo</b>"]:::process
  IN --> S1
  S2["Pin application images and build<br/>dependencies<br/><b>Release manifest</b>"]:::process
  S1 --> S2
  S3["Validate schema, secrets handling and<br/>regression tests<br/><b>Trivy / Playwright / validators</b>"]:::process
  S2 --> S3
  S4["Rehearse backup and rollback for the exact<br/>release<br/><b>I23 / I24</b>"]:::process
  S3 --> S4
  GATE{"Change evidence and rollback<br/>accepted?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  S5["Promote through human approval and bounded<br/>rollout<br/><b>Ansible / OpenProject</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Traceable approved release"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>I22, I33, X12"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
classDef process fill:#f8fafc,stroke:#94a3b8,color:#172554,stroke-width:1.4px;
classDef gate fill:#fff7d6,stroke:#d97706,color:#78350f,stroke-width:1.8px;
classDef control fill:#ede9fe,stroke:#8b5cf6,color:#4c1d95,stroke-dasharray:5 4;
classDef done fill:#ccfbf1,stroke:#0f766e,color:#134e4a,stroke-width:1.8px;
classDef hold fill:#fff1f2,stroke:#e11d48,color:#881337,stroke-width:1.5px;
classDef legacy fill:#fdf2f8,stroke:#9d174d,color:#831843;
classDef ext fill:#ecfeff,stroke:#0891b2,color:#164e63;

