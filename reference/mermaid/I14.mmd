flowchart TB
  IN["I14: New endpoint, renewal or migration"]:::source
  CONTROL["Required controls<br/>X11"]:::control
  S1["Map intended public/private vhost and<br/>upstream<br/><b>Caddy / route register</b>"]:::process
  IN --> S1
  S2["Select supported ACME or certificate<br/>deployment method<br/><b>Caddy / existing ACME custody</b>"]:::process
  S1 --> S2
  S3["Validate challenge ownership and private<br/>keys securely<br/><b>DNS provider / SOPS</b>"]:::process
  S2 --> S3
  GATE{"Issue-deploy-reload-monitor chain<br/>proven?"}:::gate
  S3 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S4["Deploy atomically and reload one ingress<br/>owner<br/><b>Ansible / systemd</b>"]:::process
  GATE -- "Yes" --> S4
  S5["Test hostname trust, app auth and renewal<br/>alerting<br/><b>blackbox_exporter / Playwright</b>"]:::process
  S4 --> S5
  OUT["Verified TLS endpoint and renewal evidence"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>E01, M01, X01, I25"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
classDef process fill:#f8fafc,stroke:#94a3b8,color:#172554,stroke-width:1.4px;
classDef gate fill:#fff7d6,stroke:#d97706,color:#78350f,stroke-width:1.8px;
classDef control fill:#ede9fe,stroke:#8b5cf6,color:#4c1d95,stroke-dasharray:5 4;
classDef done fill:#ccfbf1,stroke:#0f766e,color:#134e4a,stroke-width:1.8px;
classDef hold fill:#fff1f2,stroke:#e11d48,color:#881337,stroke-width:1.5px;
classDef legacy fill:#fdf2f8,stroke:#9d174d,color:#831843;
classDef ext fill:#ecfeff,stroke:#0891b2,color:#164e63;

