flowchart TB
  IN["M34: Qualifying purchase or customer rewards<br/>activity"]:::source
  CONTROL["Required controls<br/>X01, X02, X03, X06, X10, X04"]:::control
  S1["Valid order event<br/><b>Native owner / bounded integration</b>"]:::process
  IN --> S1
  S2["PostgreSQL atomic points ledger<br/><b>PostgreSQL</b>"]:::process
  S1 --> S2
  S3["Eligibility + reward approval<br/><b>Native owner / bounded integration</b>"]:::process
  S2 --> S3
  GATE{"Applicable permission, approval and<br/>destination readiness valid?"}:::gate
  S3 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S4["Mautic notification<br/><b>Mautic</b>"]:::process
  GATE -- "Yes" --> S4
  S5["Redeem and audit<br/><b>Native owner / bounded integration</b>"]:::process
  S4 --> S5
  OUT["Atomic points balance, issued/redeemed<br/>reward and audit"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>M08, M05"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
classDef process fill:#f8fafc,stroke:#94a3b8,color:#172554,stroke-width:1.4px;
classDef gate fill:#fff7d6,stroke:#d97706,color:#78350f,stroke-width:1.8px;
classDef control fill:#ede9fe,stroke:#8b5cf6,color:#4c1d95,stroke-dasharray:5 4;
classDef done fill:#ccfbf1,stroke:#0f766e,color:#134e4a,stroke-width:1.8px;
classDef hold fill:#fff1f2,stroke:#e11d48,color:#881337,stroke-width:1.5px;
classDef legacy fill:#fdf2f8,stroke:#9d174d,color:#831843;
classDef ext fill:#ecfeff,stroke:#0891b2,color:#164e63;

