flowchart TB
  IN["I06: Network build or address change"]:::source
  CONTROL["Required controls<br/>X11"]:::control
  S1["Reconcile all historical DNS and route<br/>declarations<br/><b>Source DNS crosswalk</b>"]:::process
  IN --> S1
  S2["Assign canonical names and DHCP reservations<br/><b>dnsmasq / odhcpd</b>"]:::process
  S1 --> S2
  S3["Separate LAN, tailnet and public<br/>authoritative DNS<br/><b>OpenWrt / provider</b>"]:::process
  S2 --> S3
  S4["Test each name from its intended vantage<br/><b>blackbox_exporter / clients</b>"]:::process
  S3 --> S4
  GATE{"Every selected name resolves<br/>correctly?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S5["Stage controlled TTL and record changes<br/><b>Ansible / DNS API</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Versioned DNS/address map with unresolved<br/>names retained"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>I08, I14, I25"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
classDef process fill:#f8fafc,stroke:#94a3b8,color:#172554,stroke-width:1.4px;
classDef gate fill:#fff7d6,stroke:#d97706,color:#78350f,stroke-width:1.8px;
classDef control fill:#ede9fe,stroke:#8b5cf6,color:#4c1d95,stroke-dasharray:5 4;
classDef done fill:#ccfbf1,stroke:#0f766e,color:#134e4a,stroke-width:1.8px;
classDef hold fill:#fff1f2,stroke:#e11d48,color:#881337,stroke-width:1.5px;
classDef legacy fill:#fdf2f8,stroke:#9d174d,color:#831843;
classDef ext fill:#ecfeff,stroke:#0891b2,color:#164e63;

