flowchart TB
  IN["I27: Low battery, power loss or planned shutdown"]:::source
  CONTROL["Required controls<br/>X11"]:::control
  S1["Measure UPS runtime and shutdown thresholds<br/><b>NUT</b>"]:::process
  IN --> S1
  S2["Stop new render jobs and external dispatch<br/><b>systemd / channel guards</b>"]:::process
  S1 --> S2
  S3["Drain or safely interrupt critical sessions<br/><b>Pipecat / applications</b>"]:::process
  S2 --> S3
  S4["Checkpoint data and shut guests down in<br/>dependency order<br/><b>PostgreSQL / MariaDB / Proxmox</b>"]:::process
  S3 --> S4
  GATE{"Power, storage and dependency<br/>readiness restored?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S5["On power return validate storage and restore<br/>in HOLD<br/><b>smartmontools / systemd</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Controlled shutdown/restart evidence"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>I33, I24"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
classDef process fill:#f8fafc,stroke:#94a3b8,color:#172554,stroke-width:1.4px;
classDef gate fill:#fff7d6,stroke:#d97706,color:#78350f,stroke-width:1.8px;
classDef control fill:#ede9fe,stroke:#8b5cf6,color:#4c1d95,stroke-dasharray:5 4;
classDef done fill:#ccfbf1,stroke:#0f766e,color:#134e4a,stroke-width:1.8px;
classDef hold fill:#fff1f2,stroke:#e11d48,color:#881337,stroke-width:1.5px;
classDef legacy fill:#fdf2f8,stroke:#9d174d,color:#831843;
classDef ext fill:#ecfeff,stroke:#0891b2,color:#164e63;

