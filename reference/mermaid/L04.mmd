flowchart TB
  IN["L04: Approved sandbox migration"]:::source
  CONTROL["Required controls<br/>I02, I23, I30"]:::control
  S1["Inventory guest state, noVNC/SSH routes and<br/>firewall<br/><b>Legacy owner</b>"]:::process
  IN --> S1
  S2["Preserve guest disks and stopped/autostart<br/>intent<br/><b>I09</b>"]:::process
  S1 --> S2
  S3["Rebuild isolated sandbox boundary<br/><b>Proxmox / nftables</b>"]:::process
  S2 --> S3
  S4["Reconcile Windows/WSL tunnel and host-key<br/>trust<br/><b>I29</b>"]:::process
  S3 --> S4
  GATE{"Sandbox and tunnel isolation proven?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S5["Test explicitly permitted access with no<br/>public leakage<br/><b>Operator</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Qualified sandbox access or documented hold"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>I29, X09"]:::ext
  OUT --> NEXT

