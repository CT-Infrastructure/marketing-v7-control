flowchart TB
  IN["E01: Approved marketing sender activation"]:::source
  CONTROL["Required controls<br/>X02, X03, X04, X06, X09"]:::control
  S1["Approve purpose, identity and reply handling<br/><b>OpenProject</b>"]:::process
  IN --> S1
  S2["Configure external authoritative DNS and<br/>return path<br/><b>DNS provider / Ansible</b>"]:::process
  S1 --> S2
  GATE{"Authentication and owned-mailbox<br/>tests passed?"}:::gate
  S2 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S3["Enable managed SMTP and business reply<br/>mailbox<br/><b>External providers</b>"]:::process
  GATE -- "Yes" --> S3
  S4["Validate SPF, DKIM, DMARC, MX and<br/>real-message alignment<br/><b>checkdmarc / owned mailbox</b>"]:::process
  S3 --> S4
  S5["Record tested sender generation and<br/>custodians<br/><b>PostgreSQL</b>"]:::process
  S4 --> S5
  OUT["Qualified sender identity and managed<br/>transport"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>E02, E04, E07, E14"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
classDef process fill:#f8fafc,stroke:#94a3b8,color:#172554,stroke-width:1.4px;
classDef gate fill:#fff7d6,stroke:#d97706,color:#78350f,stroke-width:1.8px;
classDef control fill:#ede9fe,stroke:#8b5cf6,color:#4c1d95,stroke-dasharray:5 4;
classDef done fill:#ccfbf1,stroke:#0f766e,color:#134e4a,stroke-width:1.8px;
classDef hold fill:#fff1f2,stroke:#e11d48,color:#881337,stroke-width:1.5px;
classDef legacy fill:#fdf2f8,stroke:#9d174d,color:#831843;
classDef ext fill:#ecfeff,stroke:#0891b2,color:#164e63;

