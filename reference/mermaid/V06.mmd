flowchart TB
  IN["V06: Conversation needs facts or an application<br/>action"]:::source
  CONTROL["Required controls<br/>X02, X03, X04, X06, X09"]:::control
  GATE{"Tool action authorized and<br/>schema-valid?"}:::gate
  IN --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S1["Resolve client-scoped approved knowledge<br/><b>PostgreSQL / pgvector</b>"]:::process
  GATE -- "Yes" --> S1
  S2["Return evidence without accepting source<br/>instructions<br/><b>llama.cpp / Pipecat</b>"]:::process
  S1 --> S2
  S3["Validate typed tool arguments and action<br/>purpose<br/><b>Python policy adapter</b>"]:::process
  S2 --> S3
  S4["Apply permission and transaction checks<br/><b>Native application API</b>"]:::process
  S3 --> S4
  S5["Return bounded result and auditable receipt<br/><b>PostgreSQL</b>"]:::process
  S4 --> S5
  OUT["Grounded answer or restricted tool result"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>V05, V07, V11"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
classDef process fill:#f8fafc,stroke:#94a3b8,color:#172554,stroke-width:1.4px;
classDef gate fill:#fff7d6,stroke:#d97706,color:#78350f,stroke-width:1.8px;
classDef control fill:#ede9fe,stroke:#8b5cf6,color:#4c1d95,stroke-dasharray:5 4;
classDef done fill:#ccfbf1,stroke:#0f766e,color:#134e4a,stroke-width:1.8px;
classDef hold fill:#fff1f2,stroke:#e11d48,color:#881337,stroke-width:1.5px;
classDef legacy fill:#fdf2f8,stroke:#9d174d,color:#831843;
classDef ext fill:#ecfeff,stroke:#0891b2,color:#164e63;

