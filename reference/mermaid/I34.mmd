flowchart TB
  IN["I34: Monthly review or resource threshold"]:::source
  CONTROL["Required controls<br/>X11"]:::control
  S1["Collect measured CPU, memory, disk, GPU and<br/>queue data<br/><b>Prometheus / Grafana</b>"]:::process
  IN --> S1
  S2["Project bounded growth and backup space<br/><b>PostgreSQL snapshots</b>"]:::process
  S1 --> S2
  S3["Review service budgets and conditional<br/>adoption costs<br/><b>OpenProject</b>"]:::process
  S2 --> S3
  S4["Adjust retention and concurrency under<br/>approval<br/><b>Native apps / systemd</b>"]:::process
  S3 --> S4
  GATE{"Budget and objectives support<br/>intended load?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S5["Repeat load and recovery qualification<br/><b>Controlled tests</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Evidence-based scaling or simplification<br/>decision"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>I04, I28, I23, X11"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
classDef process fill:#f8fafc,stroke:#94a3b8,color:#172554,stroke-width:1.4px;
classDef gate fill:#fff7d6,stroke:#d97706,color:#78350f,stroke-width:1.8px;
classDef control fill:#ede9fe,stroke:#8b5cf6,color:#4c1d95,stroke-dasharray:5 4;
classDef done fill:#ccfbf1,stroke:#0f766e,color:#134e4a,stroke-width:1.8px;
classDef hold fill:#fff1f2,stroke:#e11d48,color:#881337,stroke-width:1.5px;
classDef legacy fill:#fdf2f8,stroke:#9d174d,color:#831843;
classDef ext fill:#ecfeff,stroke:#0891b2,color:#164e63;

