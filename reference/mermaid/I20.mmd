flowchart TB
  IN["I20: Router replacement or collector change"]:::source
  CONTROL["Required controls<br/>X11"]:::control
  S1["Identify actual current producer and<br/>credential custody<br/><b>Authorized scheduler inventory</b>"]:::process
  IN --> S1
  S2["Capture cadence, destination and input<br/>format<br/><b>OpenProject</b>"]:::process
  S1 --> S2
  S3["Run new ingestion in read-only shadow mode<br/><b>OTel / bounded adapter</b>"]:::process
  S2 --> S3
  S4["Compare source freshness and parser output<br/><b>PostgreSQL / Grafana</b>"]:::process
  S3 --> S4
  GATE{"Exactly one authorized producer<br/>active?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S5["Disable old producer before enabling<br/>replacement<br/><b>systemd / operator</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Verified router telemetry feed and<br/>continuity receipt"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>X09, I25"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
classDef process fill:#f8fafc,stroke:#94a3b8,color:#172554,stroke-width:1.4px;
classDef gate fill:#fff7d6,stroke:#d97706,color:#78350f,stroke-width:1.8px;
classDef control fill:#ede9fe,stroke:#8b5cf6,color:#4c1d95,stroke-dasharray:5 4;
classDef done fill:#ccfbf1,stroke:#0f766e,color:#134e4a,stroke-width:1.8px;
classDef hold fill:#fff1f2,stroke:#e11d48,color:#881337,stroke-width:1.5px;
classDef legacy fill:#fdf2f8,stroke:#9d174d,color:#831843;
classDef ext fill:#ecfeff,stroke:#0891b2,color:#164e63;

