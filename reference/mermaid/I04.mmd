flowchart TB
  IN["I04: Approved destination build"]:::source
  CONTROL["Required controls<br/>X11"]:::control
  S1["Inventory CPU, RAM, NICs, storage and IOMMU<br/><b>Ansible / hardware tools</b>"]:::process
  IN --> S1
  S2["Validate wired management and out-of-band<br/>console<br/><b>Operator / switch</b>"]:::process
  S1 --> S2
  S3["Install supported Proxmox host platform<br/><b>Proxmox VE</b>"]:::process
  S2 --> S3
  S4["Create storage and VM network boundaries<br/><b>QEMU/KVM / Proxmox</b>"]:::process
  S3 --> S4
  GATE{"Capacity and isolation accepted?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S5["Reserve recovery capacity and benchmark<br/>disks<br/><b>smartmontools / controlled tests</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Destination host with documented hardware<br/>and storage budget"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>I09, I10, I27, I28, I34"]:::ext
  OUT --> NEXT

