flowchart TB
  IN["X01: Webhook, scheduled poll or human request"]:::source
  S1["Verify signature, timestamp, origin and<br/>schema<br/><b>Activepieces / bounded adapter</b>"]:::process
  IN --> S1
  S2["Resolve client and authoritative object<br/>references<br/><b>Native APIs</b>"]:::process
  S1 --> S2
  S3["Apply payload size and secret/PII<br/>minimization<br/><b>Python validators</b>"]:::process
  S2 --> S3
  S4["Persist authenticated event receipt<br/><b>PostgreSQL</b>"]:::process
  S3 --> S4
  GATE{"Event authenticity and scope valid?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  S5["Acknowledge only after durable intake<br/><b>Activepieces</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Normalized immutable event envelope"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>X02, M36, E06, V11"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
classDef process fill:#f8fafc,stroke:#94a3b8,color:#172554,stroke-width:1.4px;
classDef gate fill:#fff7d6,stroke:#d97706,color:#78350f,stroke-width:1.8px;
classDef control fill:#ede9fe,stroke:#8b5cf6,color:#4c1d95,stroke-dasharray:5 4;
classDef done fill:#ccfbf1,stroke:#0f766e,color:#134e4a,stroke-width:1.8px;
classDef hold fill:#fff1f2,stroke:#e11d48,color:#881337,stroke-width:1.5px;
classDef legacy fill:#fdf2f8,stroke:#9d174d,color:#831843;
classDef ext fill:#ecfeff,stroke:#0891b2,color:#164e63;

