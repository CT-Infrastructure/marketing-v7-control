flowchart TB
  IN["V07: Caller requests a human or agent reaches<br/>limit"]:::source
  CONTROL["Required controls<br/>X02, X03, X04, X06, X09"]:::control
  S1["Stop autonomous high-risk tool execution<br/><b>Pipecat</b>"]:::process
  IN --> S1
  S2["Summarize only authorized call context<br/><b>llama.cpp / controller</b>"]:::process
  S1 --> S2
  S3["Check agent availability or approved booking<br/>system<br/><b>OpenProject / conditional Easy!Appointments</b>"]:::process
  S2 --> S3
  GATE{"Handoff destination available and<br/>permitted?"}:::gate
  S3 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S4["Transfer via verified telephony path or<br/>create follow-up<br/><b>Asterisk / OpenProject</b>"]:::process
  GATE -- "Yes" --> S4
  S5["Confirm handoff outcome before closing<br/><b>PostgreSQL</b>"]:::process
  S4 --> S5
  OUT["Confirmed transfer, booking or assigned<br/>follow-up"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>V11, M03"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
classDef process fill:#f8fafc,stroke:#94a3b8,color:#172554,stroke-width:1.4px;
classDef gate fill:#fff7d6,stroke:#d97706,color:#78350f,stroke-width:1.8px;
classDef control fill:#ede9fe,stroke:#8b5cf6,color:#4c1d95,stroke-dasharray:5 4;
classDef done fill:#ccfbf1,stroke:#0f766e,color:#134e4a,stroke-width:1.8px;
classDef hold fill:#fff1f2,stroke:#e11d48,color:#881337,stroke-width:1.5px;
classDef legacy fill:#fdf2f8,stroke:#9d174d,color:#831843;
classDef ext fill:#ecfeff,stroke:#0891b2,color:#164e63;

