flowchart TB
  IN["V01: Authorized telephone channel activation"]:::source
  CONTROL["Required controls<br/>X02, X03, X04, X06, X09"]:::control
  GATE{"Carrier, media and policy<br/>qualification passed?"}:::gate
  IN --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S1["Approve carrier account and telephone<br/>identity<br/><b>External SIP trunk / owner</b>"]:::process
  GATE -- "Yes" --> S1
  S2["Configure isolated SIP/RTP and private<br/>control interfaces<br/><b>Asterisk PJSIP / ARI</b>"]:::process
  S1 --> S2
  S3["Pin chan_websocket and bridge compatibility<br/><b>Asterisk / pipecat-asterisk</b>"]:::process
  S2 --> S3
  S4["Configure separate secrets and resource<br/>boundaries<br/><b>SOPS / Debian VM</b>"]:::process
  S3 --> S4
  S5["Test owned-number codec, media and failure<br/>behavior<br/><b>Pipecat / controlled calls</b>"]:::process
  S4 --> S5
  OUT["Validated voice transport foundation"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>V02, V05"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
