flowchart TB
  IN["I03: Before destructive change or disaster drill"]:::source
  CONTROL["Required controls<br/>X11"]:::control
  S1["Inventory secret and certificate references<br/>only<br/><b>SOPS / age</b>"]:::process
  IN --> S1
  S2["Export encrypted recovery credentials and<br/>trust records<br/><b>Vaultwarden / KeePassXC</b>"]:::process
  S1 --> S2
  S3["Preserve decryption keys outside the<br/>affected host<br/><b>Offline custody</b>"]:::process
  S2 --> S3
  GATE{"Independent recovery access proven?"}:::gate
  S3 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S4["Package router config, host inventory and<br/>restore instructions<br/><b>Git / restic</b>"]:::process
  GATE -- "Yes" --> S4
  S5["Test access without Keycloak, DNS or the<br/>main server<br/><b>Authorized operator</b>"]:::process
  S4 --> S5
  OUT["Offline bootstrap kit and tested custody<br/>receipt"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>I12, I24, I35"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
classDef process fill:#f8fafc,stroke:#94a3b8,color:#172554,stroke-width:1.4px;
classDef gate fill:#fff7d6,stroke:#d97706,color:#78350f,stroke-width:1.8px;
classDef control fill:#ede9fe,stroke:#8b5cf6,color:#4c1d95,stroke-dasharray:5 4;
classDef done fill:#ccfbf1,stroke:#0f766e,color:#134e4a,stroke-width:1.8px;
classDef hold fill:#fff1f2,stroke:#e11d48,color:#881337,stroke-width:1.5px;
classDef legacy fill:#fdf2f8,stroke:#9d174d,color:#831843;
classDef ext fill:#ecfeff,stroke:#0891b2,color:#164e63;

