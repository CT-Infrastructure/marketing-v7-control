flowchart TB
  IN["I33: Host reboot or application restart"]:::source
  CONTROL["Required controls<br/>X11"]:::control
  S1["Load reviewed Quadlet and service<br/>definitions<br/><b>systemd / Podman</b>"]:::process
  IN --> S1
  S2["Verify data and identity readiness before<br/>dependents<br/><b>PostgreSQL / MariaDB / Keycloak</b>"]:::process
  S1 --> S2
  S3["Start app-native workers with external<br/>effects held<br/><b>Activepieces / Mautic / Postiz</b>"]:::process
  S2 --> S3
  S4["Check Temporal, queue, storage and<br/>credential health<br/><b>Prometheus / application probes</b>"]:::process
  S3 --> S4
  GATE{"Readiness and reconciliation passed?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S5["Reconcile pending outcomes then approve<br/>resume<br/><b>OpenProject / channel guards</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Predictable startup with one scheduler per<br/>responsibility"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>X01, E11, V04, M36"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
classDef process fill:#f8fafc,stroke:#94a3b8,color:#172554,stroke-width:1.4px;
classDef gate fill:#fff7d6,stroke:#d97706,color:#78350f,stroke-width:1.8px;
classDef control fill:#ede9fe,stroke:#8b5cf6,color:#4c1d95,stroke-dasharray:5 4;
classDef done fill:#ccfbf1,stroke:#0f766e,color:#134e4a,stroke-width:1.8px;
classDef hold fill:#fff1f2,stroke:#e11d48,color:#881337,stroke-width:1.5px;
classDef legacy fill:#fdf2f8,stroke:#9d174d,color:#831843;
classDef ext fill:#ecfeff,stroke:#0891b2,color:#164e63;

