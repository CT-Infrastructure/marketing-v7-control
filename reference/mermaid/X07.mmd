flowchart TB
  IN["X07: Exhausted retry, invalid state or ambiguous<br/>effect"]:::source
  S1["Classify deterministic failure versus<br/>transient outage<br/><b>Activepieces</b>"]:::process
  IN --> S1
  S2["Preserve redacted event, attempt and error<br/>context<br/><b>PostgreSQL / Loki</b>"]:::process
  S1 --> S2
  S3["Assign accountable remediation and deadline<br/><b>OpenProject</b>"]:::process
  S2 --> S3
  S4["Correct source or configuration with<br/>versioned evidence<br/><b>Native owner</b>"]:::process
  S3 --> S4
  GATE{"Repair and replay authorized?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  S5["Recheck consent, approval and idempotency<br/>before replay<br/><b>X02 / channel guard</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Resolved exception or an auditable<br/>continuing hold"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>X01, X02, X11"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
classDef process fill:#f8fafc,stroke:#94a3b8,color:#172554,stroke-width:1.4px;
classDef gate fill:#fff7d6,stroke:#d97706,color:#78350f,stroke-width:1.8px;
classDef control fill:#ede9fe,stroke:#8b5cf6,color:#4c1d95,stroke-dasharray:5 4;
classDef done fill:#ccfbf1,stroke:#0f766e,color:#134e4a,stroke-width:1.8px;
classDef hold fill:#fff1f2,stroke:#e11d48,color:#881337,stroke-width:1.5px;
classDef legacy fill:#fdf2f8,stroke:#9d174d,color:#831843;
classDef ext fill:#ecfeff,stroke:#0891b2,color:#164e63;

