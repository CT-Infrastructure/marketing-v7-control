flowchart TB
  IN["V12: Model, bridge, carrier or load change"]:::source
  CONTROL["Required controls<br/>X02, X03, X04, X06, X09"]:::control
  S1["Run owned-number functional and failure<br/>scenarios<br/><b>Controlled test harness</b>"]:::process
  IN --> S1
  S2["Measure STT, first audio, interruption and<br/>transfer quality<br/><b>Prometheus / MLflow</b>"]:::process
  S1 --> S2
  S3["Exercise concurrent load and GPU isolation<br/><b>I28 / Pipecat</b>"]:::process
  S2 --> S3
  S4["Hold affected campaigns on regression<br/><b>Python controller</b>"]:::process
  S3 --> S4
  GATE{"Quality and safety acceptance passed?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S5["Approve new canary after evidence review<br/><b>OpenProject</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Measured voice release or held incident"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>V01, V03, V04"]:::ext
  OUT --> NEXT

