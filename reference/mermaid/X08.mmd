flowchart TB
  IN["X08: Verified deletion, withdrawal or retention<br/>deadline"]:::source
  S1["Verify requester and exact data/client scope<br/><b>Native authority / human review</b>"]:::process
  IN --> S1
  S2["Apply legal hold and retention rules<br/><b>OpenProject</b>"]:::process
  S1 --> S2
  S3["Remove or restrict authoritative app records<br/>and derivatives<br/><b>Mautic / ResourceSpace / PostgreSQL</b>"]:::process
  S2 --> S3
  S4["Propagate to caches, exports and vector<br/>indexes<br/><b>Activepieces</b>"]:::process
  S3 --> S4
  GATE{"Required scope reconciled with<br/>retention rules?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  S5["Maintain minimal permitted suppression and<br/>backup-deletion policy<br/><b>Protected audit ledger</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Documented privacy action and downstream<br/>receipts"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>M36, I23, V10, E06"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
classDef process fill:#f8fafc,stroke:#94a3b8,color:#172554,stroke-width:1.4px;
classDef gate fill:#fff7d6,stroke:#d97706,color:#78350f,stroke-width:1.8px;
classDef control fill:#ede9fe,stroke:#8b5cf6,color:#4c1d95,stroke-dasharray:5 4;
classDef done fill:#ccfbf1,stroke:#0f766e,color:#134e4a,stroke-width:1.8px;
classDef hold fill:#fff1f2,stroke:#e11d48,color:#881337,stroke-width:1.5px;
classDef legacy fill:#fdf2f8,stroke:#9d174d,color:#831843;
classDef ext fill:#ecfeff,stroke:#0891b2,color:#164e63;

