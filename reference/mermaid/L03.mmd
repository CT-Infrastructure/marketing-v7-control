flowchart TB
  IN["L03: Approved workspace or coding-agent migration"]:::source
  CONTROL["Required controls<br/>I02, I23, I30"]:::control
  S1["Distinguish host Coven and Herdr VM state<br/>roots<br/><b>Legacy manifest</b>"]:::process
  IN --> S1
  S2["Capture worktrees, session databases and<br/>pending actions<br/><b>Git / restic / owner</b>"]:::process
  S1 --> S2
  S3["Preserve private credentials through<br/>protected custody<br/><b>SOPS / age</b>"]:::process
  S2 --> S3
  GATE{"Exact session scope and one owner<br/>approved?"}:::gate
  S3 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S4["Restore with autonomous actions disabled<br/><b>Proxmox / Podman</b>"]:::process
  GATE -- "Yes" --> S4
  S5["Reconcile receipts and original run window<br/><b>I30</b>"]:::process
  S4 --> S5
  OUT["Recoverable workspaces without duplicated<br/>autonomous work"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>X11"]:::ext
  OUT --> NEXT

