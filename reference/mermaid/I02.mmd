flowchart TB
  IN["I02: Inventory or proposed change"]:::source
  CONTROL["Required controls<br/>X11"]:::control
  S1["Apply V7 technology decisions over<br/>historical recipes<br/><b>OpenProject</b>"]:::process
  IN --> S1
  S2["Classify selected, conditional, legacy-held<br/>and retired<br/><b>Versioned disposition register</b>"]:::process
  S1 --> S2
  S3["Assign accountable owner and exact data<br/>scope<br/><b>OpenProject</b>"]:::process
  S2 --> S3
  S4["Define target role and exit criteria<br/><b>Ansible inventory</b>"]:::process
  S3 --> S4
  GATE{"Owner and disposition approved?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S5["Approve activation separately from<br/>preservation<br/><b>Human owner</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Approved target scope without accidental<br/>legacy reactivation"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>I05, I09, I11, I31, I32"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
