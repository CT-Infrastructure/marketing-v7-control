flowchart TB
  IN["I19: Service onboarding or monitoring review"]:::source
  CONTROL["Required controls<br/>X11"]:::control
  S1["Collect metrics and redacted logs with<br/>owners<br/><b>OTel Collector / exporters</b>"]:::process
