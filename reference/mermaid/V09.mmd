flowchart TB
  IN["V09: Call completes, fails or loses media"]:::source
  CONTROL["Required controls<br/>X02, X03, X04, X06, X09"]:::control
  S1["Close call resources and capture final<br/>identifiers<br/><b>Asterisk / Pipecat</b>"]:::process
  IN --> S1
  S2["Classify outcome using confirmed evidence<br/><b>Python controller</b>"]:::process
  S1 --> S2
  S3["Reconcile unknown carrier or channel state<br/><b>ARI / carrier API</b>"]:::process
  S2 --> S3
  S4["Apply bounded retry windows and consent<br/>recheck<br/><b>PostgreSQL / V02</b>"]:::process
  S3 --> S4
  GATE{"Retry safe and newly eligible?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  CONTROL -. "enforced at action boundary" .-> GATE
  S5["Escalate exhausted or ambiguous attempts<br/><b>OpenProject</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Terminal disposition or scheduled authorized<br/>retry"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>V10, V11, V02"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
