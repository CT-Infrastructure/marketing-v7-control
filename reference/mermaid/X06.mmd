flowchart TB
  IN["X06: API timeout, send attempt or restored queue"]:::source
  S1["Load action key and expected destination<br/>state<br/><b>PostgreSQL</b>"]:::process
  IN --> S1
  S2["Query supported provider/native state using<br/>existing ID<br/><b>WordPress / Postiz / SMTP / carrier APIs</b>"]:::process
  S1 --> S2
  S3["Distinguish confirmed success, confirmed<br/>failure and unknown<br/><b>Bounded adapter</b>"]:::process
  S2 --> S3
  S4["Update receipt and native owner without<br/>inventing status<br/><b>Activepieces</b>"]:::process
  S3 --> S4
  GATE{"Outcome confirmed or safely<br/>retryable?"}:::gate
  S4 --> GATE
  GATE -- "No / unknown" --> HOLD["HOLD<br/>Repair, review or reconcile"]:::hold
  S5["Escalate unresolvable outcomes before retry<br/><b>OpenProject</b>"]:::process
  GATE -- "Yes" --> S5
  OUT["Reconciled external state or an UNKNOWN hold"]:::done
  S5 --> OUT
  NEXT["Connected handoffs<br/>X07, X10, E06, V11, M36"]:::ext
  OUT --> NEXT

classDef source fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.6px;
classDef process fill:#f8fafc,stroke:#94a3b8,color:#172554,stroke-width:1.4px;
classDef gate fill:#fff7d6,stroke:#d97706,color:#78350f,stroke-width:1.8px;
classDef control fill:#ede9fe,stroke:#8b5cf6,color:#4c1d95,stroke-dasharray:5 4;
classDef done fill:#ccfbf1,stroke:#0f766e,color:#134e4a,stroke-width:1.8px;
classDef hold fill:#fff1f2,stroke:#e11d48,color:#881337,stroke-width:1.5px;
classDef legacy fill:#fdf2f8,stroke:#9d174d,color:#831843;
classDef ext fill:#ecfeff,stroke:#0891b2,color:#164e63;

