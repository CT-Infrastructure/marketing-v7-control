{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketing-v7:runtime:action-receipt:1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "receipt_id": {
      "$ref": "urn:marketing-v7:runtime:common:1.0#/$defs/id"
    },
    "action_identity": {
      "$ref": "urn:marketing-v7:runtime:common:1.0#/$defs/action_identity"
    },
    "action_key": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "minLength": 71,
      "maxLength": 71
    },
    "event_id": {
      "$ref": "urn:marketing-v7:runtime:common:1.0#/$defs/id"
    },
    "correlation_id": {
      "$ref": "urn:marketing-v7:runtime:common:1.0#/$defs/id"
    },
    "approval_ref": {
      "anyOf": [
        {
          "$ref": "urn:marketing-v7:runtime:common:1.0#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "destination": {
      "$ref": "urn:marketing-v7:runtime:common:1.0#/$defs/id"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "recorded_at": {
      "$ref": "urn:marketing-v7:runtime:common:1.0#/$defs/datetime"
    },
    "status": {
      "enum": [
        "HELD",
        "SUBMITTED",
        "ACCEPTED",
        "REJECTED",
        "UNKNOWN",
        "RECONCILED"
      ]
    },
    "provider_object_ref": {
      "anyOf": [
        {
          "$ref": "urn:marketing-v7:runtime:common:1.0#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_ref": {
      "$ref": "urn:marketing-v7:runtime:common:1.0#/$defs/id"
    },
    "reconciliation_ref": {
      "anyOf": [
        {
          "$ref": "urn:marketing-v7:runtime:common:1.0#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "outbound_state": {
      "enum": [
        "HOLD",
        "CONFIRMED"
      ]
    },
    "reservation_retained": {
      "type": "boolean"
    },
    "reconciliation_outcome": {
      "enum": [
        null,
        "OCCURRED",
        "NOT_OCCURRED"
      ]
    }
  },
  "required": [
    "schema_version",
    "receipt_id",
    "action_identity",
    "action_key",
    "event_id",
    "correlation_id",
    "approval_ref",
    "destination",
    "attempt",
    "recorded_at",
    "status",
    "provider_object_ref",
    "evidence_ref",
    "reconciliation_ref",
    "outbound_state",
    "reservation_retained",
    "reconciliation_outcome"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "HELD",
              "SUBMITTED",
              "UNKNOWN"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "outbound_state": {
            "const": "HOLD"
          },
          "reservation_retained": {
            "const": true
          }
        },
        "required": []
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ACCEPTED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "provider_object_ref": {
            "type": "string",
            "minLength": 1
          },
          "outbound_state": {
            "const": "CONFIRMED"
          },
          "reservation_retained": {
            "const": true
          }
        },
        "required": []
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "RECONCILED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "reconciliation_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": []
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "UNKNOWN"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "reconciliation_ref": {
            "type": "null"
          }
        },
        "required": []
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "not": {
              "const": "RECONCILED"
            }
          }
        }
      },
      "then": {
        "properties": {
          "reconciliation_outcome": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "RECONCILED"
          }
        }
      },
      "then": {
        "properties": {
          "reconciliation_outcome": {
            "enum": [
              "OCCURRED",
              "NOT_OCCURRED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reconciliation_outcome": {
            "const": "OCCURRED"
          }
        }
      },
      "then": {
        "properties": {
          "provider_object_ref": {
            "type": "string",
            "minLength": 1
          },
          "outbound_state": {
            "const": "CONFIRMED"
          },
          "reservation_retained": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reconciliation_outcome": {
            "const": "NOT_OCCURRED"
          }
        }
      },
      "then": {
        "properties": {
          "outbound_state": {
            "const": "HOLD"
          },
          "reservation_retained": {
            "const": false
          },
          "provider_object_ref": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "REJECTED"
          }
        }
      },
      "then": {
        "properties": {
          "outbound_state": {
            "const": "HOLD"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "SUBMITTED",
              "ACCEPTED",
              "REJECTED",
              "UNKNOWN",
              "RECONCILED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "approval_ref": {
            "$ref": "urn:marketing-v7:runtime:common:1.0#/$defs/id"
          }
        }
      }
    }
  ]
}
