flowchart TD
  A["Reviewed task graph<br/>759 non-epic records"]:::controller --> B["READY frontier<br/>Prerequisites accepted"]:::controller
  B --> C{"Capacity + cost + provider limits<br/>Path and environment locks"}:::gate
  C -- "Admit" --> D["Atomic claim<br/>Lease + fence + immutable input"]:::controller
  C -- "Not yet" --> WAIT["Wait or record blocker<br/>Other ready work continues"]:::hold
  D --> W1["Implementation agent<br/>Isolated writable scope"]:::worker
  D --> W2["Independent test author<br/>Separate test scope"]:::worker
  D --> W3["Component specialist<br/>Pinned native/container package"]:::worker
  W1 --> OUT["Host validates files + hashes<br/>Reject stale or out-of-scope output"]:::controller
  W2 --> OUT
  W3 --> OUT
  OUT --> R["Independent review + exact-revision CI<br/>Security owner where required"]:::gate
  R --> M["Trusted integrator<br/>Serialize conflicting main changes"]:::controller
  M --> ACC["Verified merge or execution receipt<br/>ACCEPTED unlocks dependents"]:::pass
  ACC -. "Recompute frontier" .-> B
  D -. "Heartbeat lost / uncertain effect" .-> Q["ORPHANED<br/>Keep locks and reservations"]:::hold
  Q --> K["Kill + reap + reconcile<br/>Reject stale results; bounded retry"]:::gate
  K -. "Only after proof" .-> B
  STOP["Operator STOP<br/>No new claims; quarantine uncertainty"]:::hold -.-> D

classDef controller fill:#e9e9ff,stroke:#7771bb,color:#282354,stroke-width:1.4px
classDef worker fill:#eef7ff,stroke:#7a9abb,color:#173651,stroke-width:1.4px
classDef gate fill:#fff3d7,stroke:#c09b43,color:#49380d,stroke-width:1.4px
classDef pass fill:#def5ef,stroke:#3a9b87,color:#184b40,stroke-width:1.4px
classDef hold fill:#fee8e8,stroke:#c87575,color:#672c2c,stroke-width:1.4px
