flowchart TD
  SOURCE["V7 source package<br/>190 workflows / 147 component records"]:::controller --> INTAKE["Foundation contracts<br/>Ownership, schemas, test fixtures"]:::controller
  INTAKE --> APP["Component packages<br/>Native / containers / bounded jobs"]:::worker
  INTAKE --> BUILD["190 BUILD issues<br/>Disabled-by-default implementations"]:::worker
  INTAKE --> TEST["190 TEST issues<br/>Independent fixtures and negative cases"]:::worker
  INTAKE --> SEC["Security + agent runtime qualification<br/>Budgets, secrets, egress, merge policy"]:::gate
  BUILD --> VERIFY["190 VERIFY issues<br/>Independent execution at stated level"]:::controller
  TEST --> VERIFY
  APP --> VERIFY
  VERIFY --> INT["10 integrated slices<br/>Real control boundaries + held recovery"]:::controller
  SEC --> INT
  INT --> ENG["Engineering acceptance<br/>Evidence tied to revision and environment"]:::pass
  ENG --> HUMAN{"12 named human gates<br/>Site / channel / artifact / limits"}:::gate
  HUMAN -- "Explicit authorization only" --> PROD["Controlled production action<br/>Separate operator, separate credentials"]:::pass
  OPTIONAL["40 conditional selection tasks<br/>Deferred unless justified"]:::hold -. "Reviewed selection" .-> APP
  RAW["Private migration evidence<br/>329 opaque row references"]:::hold -. "Authorized sanitized intake" .-> INTAKE

