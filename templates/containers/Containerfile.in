# REVIEW TEMPLATE: exact base digest and dependency lock required.
FROM REGISTRY/BASE@sha256:REVIEWED_DIGEST
# Install only approved locked dependencies in a reviewed build stage.
WORKDIR /app
COPY --chown=10001:10001 app/ /app/
USER 10001:10001
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# Runtime config and credentials are mounted, not baked into the image.
ENTRYPOINT ["/app/REVIEWED_ENTRYPOINT"]
